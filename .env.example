NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://hoanglong:hoanglong_local@localhost:5433/phu_tung_hoang_long?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
SWAGGER_ENABLED=true
UPLOAD_DIR=uploads
# URL public của API, dùng để trả URL tuyệt đối cho ảnh đã upload.
PUBLIC_API_BASE_URL=http://localhost:3000
# Optional: configure both values, then run npm run prisma:seed
ADMIN_EMAIL=
ADMIN_PASSWORD=
